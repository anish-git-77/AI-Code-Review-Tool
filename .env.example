# Server
PORT=4000
CLIENT_URL=http://localhost:5173

# Postgres
DATABASE_URL=postgresql://user:password@localhost:5432/ai_code_review

# JWT (your own app session, separate from GitHub's token)
JWT_SECRET=replace_with_a_long_random_string

# GitHub OAuth App (create one at https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# Used to symmetrically encrypt the GitHub access token before storing it
TOKEN_ENCRYPTION_KEY=replace_with_32_byte_hex_key

# LLM provider (Anthropic example — swap for OpenAI etc. if you prefer)
ANTHROPIC_API_KEY=your_llm_api_key
